{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "sourceMap": false,
    "declaration": false,
    "outDir": "./bin",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "removeComments": false,
    "importHelpers": false,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES6", "DOM"]
  },
  "types": ["node"],
  "include": ["src"],
  "exclude": ["node_modules"]
}
